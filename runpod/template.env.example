# Environment Configuration Template
# Copy this file to .env and fill in your credentials

# ================================================================
# Required Variables
# ================================================================

# Hugging Face API Token (required)
# Get your token from: https://huggingface.co/settings/tokens
# Required to download LiquidAI/LFM2-700M and Amod/mental_health_counseling_conversations
HF_TOKEN=<HF_TOKEN>

# ================================================================
# Optional Variables
# ================================================================

# Weights & Biases API Key (optional - for experiment tracking)
# Get your key from: https://wandb.ai/authorize
# Leave empty to disable W&B logging
WANDB_API_KEY=<WANDB_API_KEY>

# LEAP API Key (optional - may be required for bundling)
# Contact Liquid AI for access: https://leap.liquid.ai
LEAP_API_KEY=<LEAP_API_KEY>

# Job name (auto-generated if not set)
# Used for naming checkpoints, bundles, and logs
# JOB_NAME=lfm2-700m-mental-health-20250108-120000

# GPU Configuration
# Specify which GPU(s) to use (comma-separated for multiple)
CUDA_VISIBLE_DEVICES=0

# ================================================================
# Advanced Configuration (usually not needed)
# ================================================================

# Hugging Face cache directory
# HF_HOME=/workspace/.cache/huggingface

# Training hyperparameters (override config defaults)
# LEARNING_RATE=2e-4
# NUM_TRAIN_EPOCHS=3
# PER_DEVICE_TRAIN_BATCH_SIZE=4
# GRADIENT_ACCUMULATION_STEPS=4

# ================================================================
# Usage Instructions
# ================================================================
#
# Local Docker:
#   1. Copy this file: cp runpod/template.env.example .env
#   2. Fill in your tokens in .env
#   3. Run: docker run --gpus all --env-file .env -it lfm2-mental-health
#
# Runpod:
#   1. Set environment variables in Runpod pod configuration
#   2. At minimum, set HF_TOKEN
#   3. Start command: bash /workspace/runpod/start.sh
#
